[
  {
    "dialogue_id": "S12-U001",
    "speaker": "내레이션",
    "text": "Pinocchio was almost inside the school."
  },
  {
    "dialogue_id": "S12-U002",
    "speaker": "내레이션",
    "text": "But something unexpected happened."
  },
  {
    "dialogue_id": "S12-U003",
    "speaker": "귀뚜라미",
    "text": "Oh! Help!"
  },
  {
    "dialogue_id": "S12-U004",
    "speaker": "귀뚜라미",
    "text": "I'm stuck!"
  },
  {
    "dialogue_id": "S12-U005",
    "speaker": "피노키오",
    "text": "Cricket! Are you okay?"
  },
  {
    "dialogue_id": "S12-U006",
    "speaker": "귀뚜라미",
    "text": "I'm okay, but I can't get out!"
  },
  {
    "dialogue_id": "S12-U007",
    "speaker": "피노키오",
    "text": "School is starting!"
  },
  {
    "dialogue_id": "S12-U008",
    "speaker": "피노키오",
    "text": "But my friend needs help."
  },
  {
    "dialogue_id": "S12-U009",
    "speaker": "제페토",
    "text": "Pinocchio, your friend needs you."
  },
  {
    "dialogue_id": "S12-U010",
    "speaker": "제페토",
    "text": "Yoonsu, what should Pinocchio do?"
  },
  {
    "dialogue_id": "S12-U011",
    "speaker": "귀뚜라미",
    "text": "Thank you, Pinocchio!"
  },
  {
    "dialogue_id": "S12-U012",
    "speaker": "귀뚜라미",
    "text": "You helped me!"
  },
  {
    "dialogue_id": "S12-U013",
    "speaker": "피노키오",
    "text": "You're my friend."
  },
  {
    "dialogue_id": "S12-U014",
    "speaker": "피노키오",
    "text": "I couldn't leave you there."
  },
  {
    "dialogue_id": "S12-U015",
    "speaker": "제페토",
    "text": "I'm proud of you, Pinocchio."
  },
  {
    "dialogue_id": "S12-U016",
    "speaker": "제페토",
    "text": "You did the right thing."
  },
  {
    "dialogue_id": "S12-U017",
    "speaker": "내레이션",
    "text": "Then, a familiar blue light filled the air."
  },
  {
    "dialogue_id": "S12-U018",
    "speaker": "파란 요정",
    "text": "Pinocchio, I have watched you grow."
  },
  {
    "dialogue_id": "S12-U019",
    "speaker": "파란 요정",
    "text": "You told Grandpa the truth."
  },
  {
    "dialogue_id": "S12-U020",
    "speaker": "파란 요정",
    "text": "You said you were sorry."
  },
  {
    "dialogue_id": "S12-U021",
    "speaker": "파란 요정",
    "text": "You kept your promise."
  },
  {
    "dialogue_id": "S12-U022",
    "speaker": "파란 요정",
    "text": "And today, you helped a friend."
  },
  {
    "dialogue_id": "S12-U023",
    "speaker": "피노키오",
    "text": "I only wanted to help him."
  },
  {
    "dialogue_id": "S12-U024",
    "speaker": "파란 요정",
    "text": "That is what makes you kind."
  },
  {
    "dialogue_id": "S12-U025",
    "speaker": "파란 요정",
    "text": "You have a brave and caring heart."
  },
  {
    "dialogue_id": "S12-U026",
    "speaker": "파란 요정",
    "text": "Now, it's time for one last bit of magic."
  },
  {
    "dialogue_id": "S12-U027",
    "speaker": "파란 요정",
    "text": "Pinocchio, you can become a real boy!"
  },
  {
    "dialogue_id": "S12-U028",
    "speaker": "내레이션",
    "text": "And just like that, the wooden puppet became a real little boy."
  },
  {
    "dialogue_id": "S12-U029",
    "speaker": "피노키오",
    "text": "Grandpa! Look at me!"
  },
  {
    "dialogue_id": "S12-U030",
    "speaker": "피노키오",
    "text": "I'm a real boy!"
  },
  {
    "dialogue_id": "S12-U031",
    "speaker": "제페토",
    "text": "Pinocchio! My dear boy!"
  },
  {
    "dialogue_id": "S12-U032",
    "speaker": "제페토",
    "text": "You are real!"
  },
  {
    "dialogue_id": "S12-U033",
    "speaker": "귀뚜라미",
    "text": "You did it, Pinocchio!"
  },
  {
    "dialogue_id": "S12-U034",
    "speaker": "파란 요정",
    "text": "Stay kind, and keep telling the truth."
  },
  {
    "dialogue_id": "S12-U035",
    "speaker": "피노키오",
    "text": "I will. Thank you!"
  },
  {
    "dialogue_id": "S12-U036",
    "speaker": "피노키오",
    "text": "See you later, Yoonsu!"
  },
  {
    "dialogue_id": "S12-U037",
    "speaker": "내레이션",
    "text": "Pinocchio was still learning."
  },
  {
    "dialogue_id": "S12-U038",
    "speaker": "내레이션",
    "text": "He would make more mistakes."
  },
  {
    "dialogue_id": "S12-U039",
    "speaker": "내레이션",
    "text": "And he would learn many new things."
  },
  {
    "dialogue_id": "S12-U040",
    "speaker": "내레이션",
    "text": "But today, he chose to tell the truth."
  },
  {
    "dialogue_id": "S12-U041",
    "speaker": "내레이션",
    "text": "And he kept his promise."
  },
  {
    "dialogue_id": "S12-U042",
    "speaker": "파란 요정",
    "text": "Every good choice is a new beginning."
  },
  {
    "dialogue_id": "S12-U043",
    "speaker": "내레이션",
    "text": "And so, Pinocchio's wonderful adventure continued."
  },
  {
    "dialogue_id": "S12-U044",
    "speaker": "내레이션",
    "text": "The end."
  }
]
